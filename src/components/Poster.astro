---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project: p, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (file: string) => `${base}/projects/${file}`;
const yellow = index % 2 === 1;
const loading = index === 0 ? 'eager' : 'lazy';
---

<article class:list={['rs-poster', 'rs-proj', yellow ? 'yellow' : null, index % 2 ? 'tilt-l' : 'tilt-r']}>
  <div class="art">
    <img src={src(p.art.base)} alt={p.alt} width="1200" height="900" loading={loading} decoding="async" />
    <img class="reg" src={src(p.art.reg)} alt="" width="1200" height="900" loading={loading} decoding="async" />
  </div>
  <h2 data-t={p.title}><a href={p.href} target="_blank" rel="noopener">{p.title}</a></h2>
  <p>{p.blurb}</p>
  <div class="cta"><span class="host">{new URL(p.href).host}</span><span>{p.stack} →</span></div>
</article>

<style>
  .rs-proj {
    color: var(--ink);
  }
  .rs-proj.yellow {
    background: var(--yellow);
  }
  .art {
    position: relative;
  }
  .art img {
    width: 100%;
  }
  .reg {
    position: absolute;
    inset: 0;
    mix-blend-mode: multiply;
    transform: translate(1%, -1%);
    transition: transform 0.35s var(--ease);
  }
  h2 {
    font: 900 clamp(44px, 5.4vw, 104px) / 0.84 'Big Shoulders Display', sans-serif;
    text-transform: uppercase;
    text-wrap: balance;
    margin: 0.28em 0 0.12em;
    color: var(--red);
    display: grid;
  }
  /* The ghost: the title's second ink, off register. */
  h2::before,
  h2 a {
    grid-area: 1 / 1;
  }
  h2::before {
    content: attr(data-t);
    content: attr(data-t) / '';
    position: relative;
    color: var(--cobalt);
    mix-blend-mode: multiply;
    transform: translate(0.055em, 0.045em);
    transition: transform 0.35s var(--ease);
    opacity: 0.9;
    pointer-events: none;
  }
  .yellow h2 {
    color: var(--cobalt);
  }
  .yellow h2::before {
    color: var(--red);
  }
  h2 a {
    text-decoration: none;
  }
  /* The whole poster is the link's hit area. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  h2 a:focus-visible {
    outline: none;
  }
  p {
    font: 400 clamp(15px, 1.2vw, 17px) / 1.45 'Archivo', sans-serif;
    max-width: 58ch;
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    margin-top: 14px;
    padding-top: 9px;
    border-top: 2px solid var(--ink);
    font: 700 13px / 1.3 'Archivo', sans-serif;
    font-stretch: 80%;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .host {
    text-decoration: underline 2px;
    text-underline-offset: 3px;
  }
  .rs-proj:is(:hover, :has(a:focus-visible)) .reg,
  .rs-proj:is(:hover, :has(a:focus-visible)) h2::before {
    transform: none;
  }
  .rs-proj:has(a:focus-visible) {
    outline: 4px solid var(--cobalt);
    outline-offset: 8px;
  }
</style>
