---
import FogBackdrop from './FogBackdrop.astro';

const words = ['Ideas,', 'mid-fog,', 'mid-build.'];
---

<section class="hero">
  <FogBackdrop />
  <div class="container hero__inner">
    <p class="hero__eyebrow">a gallery of mini-projects</p>
    <h1 class="hero__title" aria-label={words.join(' ')}>
      <span id="hero-words" aria-hidden="true">
        {words.map((word, i) => (
          <>
            <span class="word">{word}</span>
            {i < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </span>
    </h1>
    <p class="hero__sub">
      Small experiments, still coming into focus. Some are further along than others — the haze
      tells you which.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(90vh, 44rem);
    padding-block: clamp(3rem, 10vh, 6rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: clamp(0.75rem, 1.5vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  #hero-words {
    display: inline;
  }

  .word {
    display: inline-block;
    background: var(--gradient-arcade);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .word:nth-child(1) {
    background-position: 0% 50%;
  }
  .word:nth-child(2) {
    background-position: 50% 50%;
  }
  .word:nth-child(3) {
    background-position: 100% 50%;
  }

  .hero__sub {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-dim);
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const words = document.querySelectorAll<HTMLElement>('#hero-words .word');

  if (words.length) {
    if (reduceMotion) {
      gsap.set(words, { opacity: 1, y: 0, rotate: 0 });
    } else {
      gsap.from(words, {
        opacity: 0,
        y: 40,
        rotate: () => gsap.utils.random(-6, 6),
        duration: 0.9,
        ease: 'back.out(1.7)',
        stagger: 0.12,
      });
    }
  }
</script>
