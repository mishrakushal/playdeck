---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { slug, title, status, blurb, href, fogDensity } = project;
const turbulenceId = `turb-${slug}`;
const seed = index + 1;
---

<article class="card" style={`--fog: ${fogDensity}`} data-slug={slug}>
  {href && <a class="card__link-overlay" href={href} aria-label={`Open ${title}`} />}

  <span class="card__badge">{status}</span>

  <div class="card__content">
    <h3 class="card__title">{title}</h3>
    <p class="card__blurb">{blurb}</p>
  </div>

  <div class="card__fog" aria-hidden="true">
    <div class="card__texture-parallax">
      <div class="card__texture" style={`filter: url(#${turbulenceId})`}></div>
    </div>
    <div class="card__shimmer"></div>
  </div>

  <svg class="card__filter-defs" aria-hidden="true" focusable="false">
    <filter id={turbulenceId} x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.012 0.02"
        numOctaves="2"
        seed={seed}
        result="noise"
      ></feTurbulence>
      <feColorMatrix in="noise" type="saturate" values="0"></feColorMatrix>
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.35"></feFuncA>
      </feComponentTransfer>
    </filter>
  </svg>
</article>

<style>
  .card {
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    min-height: 14rem;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid rgba(255, 255, 255, 0.08);
    --thin: 0;
    --fog-effective: max(calc(var(--fog) - (0.15 * var(--thin))), 0.42);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      --thin: 1;
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.16);
    }
  }

  .card:focus-within {
    --thin: 1;
  }

  .card.is-thinned {
    --thin: 1;
  }

  .card__link-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  .card__badge {
    position: relative;
    z-index: 4;
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--yellow);
    padding: 0.3em 0.75em;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .card__content {
    position: relative;
    z-index: 1;
    filter: blur(calc(var(--fog-effective) * 16px));
    opacity: calc(1 - (var(--fog-effective) * 0.62));
    transition: filter 0.4s ease, opacity 0.4s ease;
  }

  .card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    margin-bottom: 0.5rem;
  }

  .card__blurb {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .card__fog {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(139, 92, 246, 0.35),
      rgba(255, 45, 143, 0.3),
      rgba(34, 229, 255, 0.25)
    );
    opacity: calc(0.4 + (var(--fog-effective) * 0.4));
    transition: opacity 0.4s ease;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .card__fog {
      -webkit-backdrop-filter: blur(calc(var(--fog-effective) * 10px));
      backdrop-filter: blur(calc(var(--fog-effective) * 10px));
      background: linear-gradient(
        135deg,
        rgba(139, 92, 246, 0.22),
        rgba(255, 45, 143, 0.18),
        rgba(34, 229, 255, 0.15)
      );
    }
  }

  .card__texture-parallax {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 3;
    will-change: transform;
  }

  .card__texture {
    position: absolute;
    inset: -10%;
    mix-blend-mode: overlay;
    opacity: 0.6;
    background-color: #fff;
    animation: texture-drift 14s ease-in-out infinite;
  }

  .card__shimmer {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(
      100deg,
      transparent 20%,
      rgba(255, 255, 255, 0.16) 45%,
      transparent 70%
    );
    background-size: 220% 220%;
    animation: shimmer-sweep 6s ease-in-out infinite;
  }

  @keyframes shimmer-sweep {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes texture-drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(2%, -2%);
    }
  }

  .card__filter-defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  @media (min-width: 641px) {
    .card__texture-parallax {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__texture,
    .card__shimmer {
      animation: none;
    }
  }
</style>
