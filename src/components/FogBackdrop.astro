---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['fog-backdrop', className]} aria-hidden="true">
  <span class="blob blob--purple"></span>
  <span class="blob blob--pink"></span>
  <span class="blob blob--cyan"></span>
</div>

<style>
  .fog-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .blob {
    position: absolute;
    width: min(60vw, 32rem);
    height: min(60vw, 32rem);
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    will-change: transform;
  }

  .blob--purple {
    top: -10%;
    left: -8%;
    background: radial-gradient(circle, var(--purple), transparent 70%);
    animation: float-a 9s ease-in-out infinite;
  }

  .blob--pink {
    top: 20%;
    right: -12%;
    background: radial-gradient(circle, var(--pink), transparent 70%);
    animation: float-b 11s ease-in-out infinite;
  }

  .blob--cyan {
    bottom: -15%;
    left: 25%;
    width: min(50vw, 26rem);
    height: min(50vw, 26rem);
    background: radial-gradient(circle, var(--cyan), transparent 70%);
    animation: float-c 8s ease-in-out infinite;
  }

  @keyframes float-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(4%, 6%) scale(1.08);
    }
  }

  @keyframes float-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-6%, 4%) scale(0.95);
    }
  }

  @keyframes float-c {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(3%, -5%) scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }
</style>
